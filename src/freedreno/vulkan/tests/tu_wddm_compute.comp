#version 450

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) buffer Data {
   uint values[];
} data_buffer;

void main()
{
   uint index = gl_GlobalInvocationID.x;
   if (index < 256) {
      uint seed = data_buffer.values[index];
      data_buffer.values[index] = seed * 3u + 7u;
   }
}
